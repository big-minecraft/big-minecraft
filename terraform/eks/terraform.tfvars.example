# Copy to terraform.tfvars and edit. Do not commit terraform.tfvars.

region       = "us-east-1"
cluster_name = "bmc"

# Narrow this to your operators once you know their addresses.
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# A public server wants the world; keep this in step with
# global.edge.game.sourceRanges in values.custom.yaml.
game_allowed_cidrs = ["0.0.0.0/0"]

# Who may reach SFTP file sessions. Public by default so sessions work out of
# the box; the only thing protecting an open session is the shared SFTP
# password, which is the same for every deployment.
#
# To lock it down, list the addresses you connect from instead:
#   file_session_allowed_cidrs = ["203.0.113.4/32"]
# An empty list creates no rule and closes the ports entirely.
file_session_allowed_cidrs = ["0.0.0.0/0"]

# true (this setting): one NAT gateway shared by every private subnet -- cheapest,
# and a single-AZ failure domain for all pod egress.
# Set false for one NAT gateway per AZ: ~3x the hourly cost, survives an AZ loss.
single_nat_gateway = true

# --------------------------------------------------------------- capacity --
#
# Karpenter provisions the nodes that run game servers; the managed node group
# below carries the cluster's own add-ons. AWS service quotas are account-level
# and cannot be set from Terraform -- raise them in Service Quotas. Check your
# on-demand vCPU ceiling before scaling up:
#
#   aws service-quotas get-service-quota --service-code ec2 \
#     --quota-code L-1216C47A --query 'Quota.[QuotaName,Value]' --output text

node_instance_types     = ["m6i.xlarge"]
node_group_min_size     = 2
node_group_max_size     = 6
node_group_desired_size = 2

# Root volume for every node, managed group and Karpenter alike. Container
# images live here, and so does each instance's artifact: game pods pull into
# an emptyDir, which is backed by this disk.
node_disk_size = 50

# The ceiling on everything Karpenter may provision, and the backstop against a
# runaway scale-up billing you for a fleet. Raise it to grow past a few hundred
# game servers.
karpenter_cpu_limit = "200"

# Instance categories Karpenter may choose from: general, compute, memory.
karpenter_instance_categories = ["m", "c", "r"]

# WhenEmpty reclaims a node only once nothing runs on it, so a node left with a
# single idle server is never reclaimed and bills in full.
# WhenEmptyOrUnderutilized repacks them, at the cost of restarting the servers
# it moves.
karpenter_consolidation_policy = "WhenEmpty"
