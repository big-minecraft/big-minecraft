{{- $sftp := (.Values.global | default dict).sftp | default dict -}}
{{- $passwordAuth := true -}}
{{- if hasKey $sftp "passwordAuth" -}}
{{- $passwordAuth = $sftp.passwordAuth -}}
{{- end -}}
{{- $publicKeys := .Values.sftp.publicKeys | default list -}}
{
    "Global": {
        "Chroot": {
        "Directory": "%h",
        "StartPath": "data"
        }
    },
    "Users": [
        {
        "Username": {{ required "sftp.username was not supplied by the panel" .Values.sftp.username | quote }},
        {{- if $passwordAuth }}
        "Password": {{ required "sftp.password was not supplied by the panel" .Values.sftp.password | quote }},
        {{- end }}
        "PublicKeys": {{ $publicKeys | toJson }},
        "UID": 1001,
        "GID": 1001,
        "Directories": [
            "data"
        ]
        }
    ]
}