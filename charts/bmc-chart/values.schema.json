{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMC configuration contract",
  "description": "Validated by Helm against the merged values (values.yaml + profiles/<profile>.yaml + config/<profile>.yaml).",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "certManager",
        "panel",
        "ingress",
        "storage"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "production",
            "development"
          ]
        },
        "certManager": {
          "type": "object",
          "required": [
            "email"
          ],
          "properties": {
            "installClusterIssuer": {
              "type": "boolean"
            },
            "clusterIssuerName": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "minLength": 1,
              "pattern": "@",
              "not": {
                "pattern": "(^your-email|example\\.com$)"
              }
            }
          }
        },
        "panel": {
          "type": "object",
          "required": [
            "panelHost"
          ],
          "properties": {
            "panelHost": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "example\\.com$"
              }
            },
            "storagePath": {
              "type": "string",
              "minLength": 1
            },
            "inviteCodeExpiryDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "displayName": {
              "type": "string"
            },
            "issuer": {
              "type": "string",
              "pattern": "^(https?://|$)"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "scopes": {
              "type": "string",
              "pattern": "(^$|openid)"
            },
            "allowedGroup": {
              "type": "string"
            },
            "adminGroup": {
              "type": "string"
            },
            "autoCreateUsers": {
              "type": "boolean"
            },
            "allowLocalLogin": {
              "type": "boolean"
            }
          }
        },
        "ingress": {
          "type": "object",
          "required": [
            "host",
            "className"
          ],
          "properties": {
            "className": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "example\\.com$"
              }
            },
            "tls": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "cluster-issuer",
                    "existing-secret",
                    "none"
                  ]
                }
              }
            },
            "controller": {
              "type": "object",
              "properties": {
                "install": {
                  "type": "boolean"
                },
                "mode": {
                  "$ref": "#/$defs/haMode"
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "service": {
                  "type": "object",
                  "properties": {
                    "annotations": {
                      "type": "object"
                    },
                    "externalTrafficPolicy": {
                      "enum": [
                        "Cluster",
                        "Local"
                      ]
                    },
                    "loadBalancerIP": {
                      "type": "string"
                    },
                    "eipAllocations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^eipalloc-[0-9a-f]+$"
                      }
                    },
                    "subnets": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^subnet-[0-9a-f]+$"
                      }
                    }
                  }
                },
                "sftpPassthrough": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "minPort": {
                      "$ref": "#/$defs/port"
                    },
                    "portCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 48
                    }
                  }
                }
              }
            }
          }
        },
        "storage": {
          "type": "object",
          "required": [
            "classes"
          ],
          "properties": {
            "persistentDeployments": {
              "type": "boolean"
            },
            "classes": {
              "type": "object",
              "required": [
                "shared",
                "database"
              ],
              "properties": {
                "shared": {
                  "$ref": "#/$defs/storageClass"
                },
                "database": {
                  "$ref": "#/$defs/storageClass"
                },
                "persistent": {
                  "$ref": "#/$defs/storageClassOptional"
                }
              }
            },
            "volumeSize": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/quantity"
              }
            }
          }
        },
        "edge": {
          "type": "object",
          "properties": {
            "game": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/serviceType"
                },
                "externalTrafficPolicy": {
                  "enum": [
                    "Local",
                    "Cluster"
                  ]
                },
                "sourceRanges": {
                  "$ref": "#/$defs/cidrList"
                },
                "eipAllocations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^eipalloc-[0-9a-f]+$"
                  }
                },
                "subnets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^subnet-[0-9a-f]+$"
                  }
                }
              }
            },
            "file": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/serviceType"
                },
                "sourceRanges": {
                  "$ref": "#/$defs/cidrList"
                }
              }
            }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "host": {
              "$ref": "#/$defs/serviceHost"
            },
            "mode": {
              "$ref": "#/$defs/haMode"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "external": {
              "type": "boolean"
            },
            "externalHost": {
              "type": "string"
            },
            "externalPort": {
              "$ref": "#/$defs/port"
            },
            "port": {
              "$ref": "#/$defs/port"
            },
            "image": {
              "$ref": "#/$defs/imageName"
            },
            "tag": {
              "$ref": "#/$defs/imageTag"
            }
          }
        },
        "mariaDB": {
          "type": "object",
          "properties": {
            "host": {
              "$ref": "#/$defs/serviceHost"
            },
            "mode": {
              "$ref": "#/$defs/haMode"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "port": {
              "$ref": "#/$defs/port"
            },
            "image": {
              "$ref": "#/$defs/imageName"
            },
            "tag": {
              "$ref": "#/$defs/imageTag"
            }
          }
        },
        "mongoDB": {
          "type": "object",
          "properties": {
            "host": {
              "$ref": "#/$defs/serviceHost"
            },
            "mode": {
              "$ref": "#/$defs/haMode"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "port": {
              "$ref": "#/$defs/port"
            },
            "image": {
              "$ref": "#/$defs/imageName"
            },
            "tag": {
              "$ref": "#/$defs/imageTag"
            }
          }
        },
        "artifactStore": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "install": {
              "type": "boolean"
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "$ref": "#/$defs/quantity"
            }
          }
        },
        "sftp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "passwordAuth": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "storage"
            ],
            "properties": {
              "storage": {
                "required": [
                  "persistentDeployments"
                ],
                "properties": {
                  "persistentDeployments": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "storage": {
                "properties": {
                  "classes": {
                    "required": [
                      "persistent"
                    ],
                    "properties": {
                      "persistent": {
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "minLength": 1
                          },
                          "accessMode": {
                            "const": "ReadWriteMany"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "artifactStore"
            ],
            "properties": {
              "artifactStore": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "storage": {
                "properties": {
                  "classes": {
                    "properties": {
                      "shared": {
                        "properties": {
                          "accessMode": {
                            "const": "ReadWriteMany"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "redis"
            ],
            "properties": {
              "redis": {
                "required": [
                  "external"
                ],
                "properties": {
                  "external": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "redis": {
                "required": [
                  "externalHost"
                ],
                "properties": {
                  "externalHost": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "edge"
            ],
            "properties": {
              "edge": {
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "LoadBalancer"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "edge": {
                "properties": {
                  "file": {
                    "required": [
                      "sourceRanges"
                    ],
                    "properties": {
                      "sourceRanges": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "ingress"
            ],
            "properties": {
              "ingress": {
                "required": [
                  "controller"
                ],
                "properties": {
                  "controller": {
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "const": "ha"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "ingress": {
                "properties": {
                  "controller": {
                    "required": [
                      "replicas"
                    ],
                    "properties": {
                      "replicas": {
                        "minimum": 2
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "redis"
            ],
            "properties": {
              "redis": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "ha"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "redis": {
                "required": [
                  "replicas"
                ],
                "properties": {
                  "replicas": {
                    "minimum": 3
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mariaDB"
            ],
            "properties": {
              "mariaDB": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "ha"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "mariaDB": {
                "required": [
                  "replicas"
                ],
                "properties": {
                  "replicas": {
                    "minimum": 3
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mongoDB"
            ],
            "properties": {
              "mongoDB": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "ha"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "mongoDB": {
                "required": [
                  "replicas"
                ],
                "properties": {
                  "replicas": {
                    "minimum": 3
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "oidc"
            ],
            "properties": {
              "oidc": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "oidc": {
                "required": [
                  "issuer",
                  "clientId",
                  "clientSecret",
                  "displayName"
                ],
                "properties": {
                  "issuer": {
                    "minLength": 1,
                    "pattern": "^https?://"
                  },
                  "clientId": {
                    "minLength": 1
                  },
                  "clientSecret": {
                    "minLength": 1
                  },
                  "displayName": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "oidc"
            ],
            "properties": {
              "oidc": {
                "required": [
                  "allowLocalLogin"
                ],
                "properties": {
                  "allowLocalLogin": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "oidc": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "storageClass": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany",
            "ReadWriteOncePod"
          ]
        }
      }
    },
    "serviceType": {
      "enum": [
        "LoadBalancer",
        "NodePort",
        "ClusterIP"
      ]
    },
    "haMode": {
      "enum": [
        "single",
        "ha"
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
    },
    "cidrList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]{1,2}$"
      }
    },
    "storageClassOptional": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany",
            "ReadWriteOncePod"
          ]
        }
      }
    },
    "serviceHost": {
      "type": "string",
      "minLength": 1
    },
    "imageName": {
      "type": "string",
      "minLength": 1
    },
    "imageTag": {
      "type": "string",
      "minLength": 1
    }
  }
}
