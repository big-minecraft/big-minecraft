environments:
  default:
    values:
      - charts/bmc-chart/values.yaml                 # Neutral defaults
      - profiles/{{ env "PROFILE" | default "baremetal" }}.yaml                 # How this KIND of environment satisfies the contract
      - {{ env "BMC_VALUES_FILE" | default (printf "config/%s.yaml" (env "PROFILE" | default "baremetal")) }}   # This installation (required)
---
repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: traefik
    url: https://traefik.github.io/charts
  - name: nfs-ganesha
    url: https://kubernetes-sigs.github.io/nfs-ganesha-server-and-external-provisioner/
  - name: ot-helm
    url: https://ot-container-kit.github.io/helm-charts
  - name: mariadb-operator
    url: https://helm.mariadb.com/mariadb-operator
  - name: mongodb-helm
    url: https://mongodb.github.io/helm-charts
---
releases:
  # The ingress controller. Skipped on bare metal, where k3s owns Traefik.
  - name: traefik
    namespace: traefik
    createNamespace: true
    chart: traefik/traefik
    version: 34.4.1
    installed: {{ .Values.global.ingress.controller.install }}
    # Wait for a load balancer address before bmc-chart's Ingress triggers an
    # ACME order -- an HTTP-01 challenge against an unaddressed entryPoint fails
    # and cert-manager backs off for an hour.
    wait: true
    timeout: 300
    values:
      - deployment:
          replicas: {{ if eq .Values.global.ingress.controller.mode "ha" }}{{ .Values.global.ingress.controller.replicas }}{{ else }}1{{ end }}
        {{- if eq .Values.global.ingress.controller.mode "ha" }}
        podDisruptionBudget:
          enabled: true
          minAvailable: 1
        # Preferred, not required: required strands replicas Pending on a
        # cluster with fewer nodes than replicas.
        affinity:
          podAntiAffinity:
            preferredDuringSchedulingIgnoredDuringExecution:
              - weight: 100
                podAffinityTerm:
                  topologyKey: kubernetes.io/hostname
                  labelSelector:
                    matchLabels:
                      app.kubernetes.io/name: traefik
        {{- end }}
        # Cloud LBs probe the Service's own ports, so /ping must answer on
        # the public entryPoint.
        ping:
          entryPoint: web
        service:
          annotations:
            {{- toYaml .Values.global.ingress.controller.service.annotations | nindent 12 }}
            {{- with .Values.global.ingress.controller.service.eipAllocations }}
            # AWS ignores spec.loadBalancerIP; one allocation per subnet
            # below, or the Service stays <pending>.
            service.beta.kubernetes.io/aws-load-balancer-eip-allocations: {{ join "," . | quote }}
            {{- end }}
            {{- with .Values.global.ingress.controller.service.subnets }}
            service.beta.kubernetes.io/aws-load-balancer-subnets: {{ join "," . | quote }}
            {{- end }}
          spec:
            externalTrafficPolicy: {{ .Values.global.ingress.controller.service.externalTrafficPolicy }}
            {{- with .Values.global.ingress.controller.service.loadBalancerIP }}
            # GCP and Azure only; see values.yaml.
            loadBalancerIP: {{ . | quote }}
            {{- end }}
        {{- if .Values.global.ingress.controller.sftpPassthrough.enabled }}
        # One entryPoint per SFTP port the panel can hand out; entryPoints
        # are static controller config. bmc-chart adds the IngressRouteTCPs.
        ports:
          {{- $min := .Values.global.ingress.controller.sftpPassthrough.minPort | int }}
          {{- range $i := until (.Values.global.ingress.controller.sftpPassthrough.portCount | int) }}
          {{- $port := add $min $i }}
          sftp-{{ $port }}:
            port: {{ $port }}
            exposedPort: {{ $port }}
            protocol: TCP
            expose:
              default: true
          {{- end }}
        {{- end }}
  # Datastore operators, installed only for datastores set to mode: ha.
  # Outside the app namespace, so a namespace delete can still clear their
  # CRs' finalizers.
  - name: redis-operator
    namespace: {{ .Values.global.namespace }}-operators
    createNamespace: true
    chart: ot-helm/redis-operator
    version: 0.26.1
    installed: {{ eq .Values.global.redis.mode "ha" }}
    # Its validating webhook has no endpoints until the pod is up, and a
    # cluster resource applied before then is rejected.
    wait: true
    timeout: 300

  - name: mariadb-operator
    namespace: {{ .Values.global.namespace }}-operators
    createNamespace: true
    chart: mariadb-operator/mariadb-operator
    version: 26.6.0
    installed: {{ eq .Values.global.mariaDB.mode "ha" }}
    # Its validating webhook has no endpoints until the pod is up, and a
    # cluster resource applied before then is rejected.
    wait: true
    timeout: 300
    values:
      - crds:
          enabled: true

  - name: mongodb-operator
    namespace: {{ .Values.global.namespace }}-operators
    createNamespace: true
    chart: mongodb-helm/community-operator
    version: 0.13.0
    installed: {{ eq .Values.global.mongoDB.mode "ha" }}
    # Its validating webhook has no endpoints until the pod is up, and a
    # cluster resource applied before then is rejected.
    wait: true
    timeout: 300
    values:
      - community-operator-crds:
          enabled: true
        # Unlike the other two, this operator watches only its own namespace by
        # "*" grants the cluster-wide RBAC it needs; database.namespace puts
        # the database pods' ServiceAccount where the CR lives.
        operator:
          watchNamespace: "*"
        database:
          namespace: {{ .Values.global.namespace }}

  # Must exist before big-minecraft: a deployment whose artifact cannot be
  # fetched will not start.
  #
  # Bitnami's chart with `bitnamilegacy` images: the last anonymously
  # readable MinIO builds, frozen and unpatched, pinned by exact tag.
  # Long-term, mirror MinIO yourself or swap in another S3 implementation.
  - name: minio
    # BMC's namespace, not its own: it authenticates with bmc-secrets, and
    # secrets are namespaced.
    namespace: {{ .Values.global.namespace }}
    createNamespace: true
    chart: oci://registry-1.docker.io/bitnamicharts/minio
    version: 17.0.21
    installed: {{ .Values.global.artifactStore.install }}
    values:
      - global:
          security:
            # Required: the chart refuses images outside `bitnami/`.
            allowInsecureImages: true
        image:
          registry: docker.io
          repository: bitnamilegacy/minio
          # Matches this chart version's appVersion (2025.7.23).
          tag: 2025.7.23-debian-12-r3
        clientImage:
          registry: docker.io
          repository: bitnamilegacy/minio-client
          tag: 2025.7.21-debian-12-r2
        # Unused by BMC, and leaving it on pins a third frozen image.
        console:
          enabled: false
        mode: standalone
        # One replica is enough; distributed mode needs four nodes.
        replicaCount: 1
        auth:
          existingSecret: bmc-secrets
          # bmc-secrets uses MinIO's own key spelling, not Bitnami's default.
          rootUserSecretKey: rootUser
          rootPasswordSecretKey: rootPassword
        # On the server itself, so creating the bucket needs no second image.
        defaultBuckets: {{ .Values.global.artifactStore.bucket | quote }}
        persistence:
          enabled: true
          size: {{ .Values.global.artifactStore.size | quote }}
          {{- with .Values.global.storage.classes.database.name }}
          storageClass: {{ . | quote }}
          {{- end }}
        resources:
          requests:
            memory: 512Mi

  # ReadWriteMany storage. Must exist before big-minecraft: a PVC naming a
  # missing class stays Pending.
  - name: nfs-server-provisioner
    namespace: nfs
    createNamespace: true
    chart: nfs-ganesha/nfs-server-provisioner
    version: 1.8.0
    installed: {{ .Values.global.nfsServer.install }}
    values:
      - persistence:
          enabled: true
          storageClass: {{ .Values.global.nfsServer.backingStorageClass | quote }}
          size: {{ .Values.global.nfsServer.size | quote }}
        storageClass:
          create: true
          name: {{ .Values.global.nfsServer.storageClassName | quote }}
          # Game data outlives a session; deleting a PVC must not take it.
          reclaimPolicy: Retain
          mountOptions:
            # Block and retry rather than failing I/O when the server restarts.
            - hard
            - nfsvers=4.1

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: jetstack/cert-manager
    version: v1.12.0
    installed: {{ eq .Values.global.ingress.tls.mode "cluster-issuer" }}
    set:
      - name: installCRDs
        value: true
      - name: startupapicheck.enabled
        value: false

  - name: big-minecraft
    namespace: {{ .Values.global.namespace }}
    createNamespace: true
    chart: ./charts/bmc-chart
    values:
      - charts/bmc-chart/values.yaml
      - profiles/{{ env "PROFILE" | default "baremetal" }}.yaml
      - {{ env "BMC_VALUES_FILE" | default (printf "config/%s.yaml" (env "PROFILE" | default "baremetal")) }}
    needs:
      {{- if eq .Values.global.ingress.tls.mode "cluster-issuer" }}
      - cert-manager/cert-manager
      {{- end }}
      {{- if .Values.global.ingress.controller.install }}
      - traefik/traefik
      {{- end }}
      {{- if .Values.global.nfsServer.install }}
      - nfs/nfs-server-provisioner
      {{- end }}
      {{- if .Values.global.artifactStore.install }}
      - {{ .Values.global.namespace }}/minio
      {{- end }}
      {{- if eq .Values.global.redis.mode "ha" }}
      - {{ .Values.global.namespace }}/redis-operator
      {{- end }}
      {{- if eq .Values.global.mariaDB.mode "ha" }}
      - {{ .Values.global.namespace }}/mariadb-operator
      {{- end }}
      {{- if eq .Values.global.mongoDB.mode "ha" }}
      - {{ .Values.global.namespace }}/mongodb-operator
      {{- end }}
